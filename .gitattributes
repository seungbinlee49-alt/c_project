* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.def text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.svg text eol=lf
*.pgm binary
*.ist binary

